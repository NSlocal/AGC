<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SafetyCoreApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity android:name=".ui.SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AboutActivity" android:exported="false" />
        <activity android:name=".ui.DeviceInfoActivity" android:exported="false" />
        <activity android:name=".ui.FeedbackActivity" android:exported="false" />
        <activity android:name=".ui.PrivacySettingsActivity" android:exported="false" />
        <activity android:name=".ui.BackupRestoreActivity" android:exported="false" />

        <service android:name=".service.SystemMonitorOverlayService" android:foregroundServiceType="mediaProjection" android:exported="false" />

    </application>
</manifest>
