<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ✅ BARIS 12 — & SUDAH DI-ESCAPE JADI &amp; -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan &amp; Keamanan"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SafetyCore — Perlindungan Perangkat"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_overlay_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overlay FPS: Aktif"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_foreground_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service Latar: Berjalan"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_permission_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Izin yang dibutuhkan: Tampilkan di atas aplikasi lain &amp; Service Latar Depan"
        android:textSize="12sp"
        android:textColor="#FF8800"
        android:layout_marginTop="16dp" />

</LinearLayout>
