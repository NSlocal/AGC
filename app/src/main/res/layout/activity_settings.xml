<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F5F5F5">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⚙️ Pengaturan SafetyCore" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="32dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:layout_marginBottom="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🛡️ Pemindaian Konten" android:textSize="16sp"/>
        <Switch android:id="@+id/scan_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:layout_marginBottom="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🔳 Blur Otomatis" android:textSize="16sp"/>
        <Switch android:id="@+id/auto_blur_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:layout_marginBottom="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🚫 Blokir Konten Berbahaya" android:textSize="16sp"/>
        <Switch android:id="@+id/block_sensitive" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:layout_marginBottom="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="📊 FPS Monitor" android:textSize="16sp"/>
        <Switch android:id="@+id/fps_overlay_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:layout_marginBottom="8dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="👁️ Blur Overlay" android:textSize="16sp"/>
        <Switch android:id="@+id/blur_overlay_enabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="\nℹ️ Semua fitur dapat dimatikan kapan saja. Tidak mengirim data tanpa izin."
        android:textSize="12sp" android:padding="16dp" android:layout_marginTop="16dp" android:background="#E8F5E9"/>

    <Button android:id="@+id/btn_stop_all" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🛑 MATIKAN SEMUA FITUR" android:layout_marginTop="24dp"
        android:backgroundTint="#F44336" android:textColor="#FFFFFF"/>
</LinearLayout>
