<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".SafetyCoreApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="SafetyCore"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafetyCore">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.ContentWarningActivity" android:exported="false"
            android:theme="@style/Theme.SafetyCore.Transparent" />

        <!-- Tambahkan di dalam <application> -->
<activity android:name=".ui.HistoryActivity" android:exported="false" />
<activity android:name=".ui.ThemeSelectorActivity" android:exported="false" />
<activity android:name=".ui.LockSetupActivity" android:exported="false" />

<receiver android:name=".ui.ShareInterceptor" android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
    </intent-filter>
</receiver>

<service android:name=".overlay.SystemMonitorOverlayService" android:exported="false" />
        

        <service android:name=".content.ContentScannerService" android:foregroundServiceType="specialUse" android:exported="false" />
        <service android:name=".overlay.BlurOverlayService" android:exported="false" />
        <service android:name=".overlay.FPSOverlayService" android:exported="false" />
    </application>
</manifest>
