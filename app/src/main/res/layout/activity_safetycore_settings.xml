<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gap="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/note_placeholder"
        android:textSize="12sp"
        android:padding="10dp"
        android:background="#FFF3CD"
        android:textColor="#856404"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"/>

    <Switch
        android:id="@+id/switch_global_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_global"/>

    <Switch
        android:id="@+id/switch_scan_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_images"/>

    <Switch
        android:id="@+id/switch_nudity_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/warn_nudity"/>

    <Switch
        android:id="@+id/switch_sensitive_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/warn_sensitive"/>

    <Switch
        android:id="@+id/switch_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/blur_content"/>

    <Button
        android:id="@+id/btn_go_game_booster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_game_booster"
        android:layout_marginTop="10dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>
