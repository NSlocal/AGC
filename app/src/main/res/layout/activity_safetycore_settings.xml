<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan SafetyCore"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monitor FPS, CPU, GPU, Suhu &amp; Baterai — bisa digeser di layar!"
        android:textSize="12sp"
        android:padding="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#E3F2FD"
        android:textColor="#1565C0"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"/>

    <Switch
        android:id="@+id/switch_global_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aktifkan SafetyCore"
        android:layout_marginTop="16dp"/>

    <!-- ✅ FPS SELECTOR -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Refresh Rate:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/spinner_fps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2196F3"/>

    <!-- ✅ OVERLAY TOGGLE BUTTON -->
    <Button
        android:id="@+id/btn_toggle_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 TAMPILKAN FPS MONITOR"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingVertical="12dp"/>

    <Button
        android:id="@+id/btn_go_game_booster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎮 BUKA GAME BOOSTER"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingVertical="12dp"/>

</LinearLayout>
